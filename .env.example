# Variáveis de ambiente — copie para .env e ajuste conforme necessário

# Ativa o MSW para interceptar chamadas REST e Socket.IO (true em dev e demonstração)
VITE_ENABLE_MOCKS=true

# Cenário de mock a carregar (padrão: "default"; outros: "empty", "slow", "error", "checkout-fail", etc.)
VITE_MOCK_SCENARIO=default

# Base URL da API real (ignorada quando VITE_ENABLE_MOCKS=true)
VITE_API_BASE_URL=http://localhost:3000
