# Variáveis de ambiente — copie para .env e ajuste conforme necessário

# Ativa o MSW para interceptar chamadas REST e Socket.IO (true em dev e demonstração)
VITE_ENABLE_MOCKS=true

# Cenário de mock a carregar (padrão: "default").
# Cenários disponíveis:
#   default
#   empty
#   slow-random-latency
#   out-of-order
#   network-failure
#   http-4xx
#   http-5xx
#   session-expired
#   signup-conflict
#   coupon-invalid
#   coupon-expired
#   price-changed-at-checkout
#   sold-out-at-checkout
#   timeout-after-order-created
#   payment-confirmed
#   payment-refused
#   wallet-refused
VITE_MOCK_SCENARIO=default

# Base URL da API (mesma origem por padrão; com mocks ligados o MSW intercepta /api/*)
VITE_API_BASE_URL=/api
